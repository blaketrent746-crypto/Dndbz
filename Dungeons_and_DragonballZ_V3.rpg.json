  "ddbz_compendium": {
    "system_rules": {
      "stamina": "At level 1, Stamina = 1 + Con mod (+1 per level). Regain half on short rest, full on long rest. 1 Stamina = +10 ft speed or +1 extra attack (max Prof Bonus). Maneuvers: Block (3 Stam), Clash (2 Stam), Counter (5 Stam), Deflection (1-Lvl Stam), Power Hit & Follow Up (2 Stam), Power Strike (1+ Stam), Wild Sense (3 Stam), Burst Attack (half upkeep Stam), Interception (3 Stam).",
      "ki": "Ki gained per level = Con mod + Wis mod + Class Ki Modifier. Refill half on short rest, full on long rest. 0 Ki = Ki Exhaustion (cannot fly, use Ki techniques, transform, concentrate on Ki techniques, and lose Prof Bonus to AC). Basic Ki Blast: Action, 30/90 ft, Dex ranged attack, 1d4 + Dex ki damage.",
      "god_ki": "Obtained at level 20, unlocking a Godly Transformation, or meditating for 1 Action to convert 200 Ki into 1 God Ki (max 3). Increases Ability Score Maximum by 2. Uses: replace 200 Ki (ignores resistance, immunity becomes resistance, +1 damage per 5 excess Ki), end 1 condition, declare hit before roll, declare crit before roll (3x on natural crit), regain 15 Stamina, or auto-pass a save/skill check.",
      "ki_rank": "Rank 1 (Lvl 1), Rank 2 (Lvl 5), Rank 3 (Lvl 10), Rank 4 (Lvl 15).",
      "power_and_overload": "Each +1 Power gives +1 attack rolls, technique/maneuver Save DCs, and Spirit checks, and -1 Ki Stealth/Control. Every +2 Power gives +1 AC and +1 saving throws. Overload threshold = Prof Bonus + God Ki. Exceeding threshold at start of turn: +1 over ends all Forms & Stunned; +2: 1d4 Destruction; +3: 1d6; +4: 1d8; +5: 1d10; +6: 1d12; +7+: +1d6 per point.",
      "proficiency_progression": "Lvl 1-3: +3 | Lvl 4-6: +4 | Lvl 7-9: +5 | Lvl 10-12: +6 | Lvl 13-15: +7 | Lvl 16-18: +8 | Lvl 19-20: +9.",
      "new_skills": [
        "Spirit (Wis)",
        "Ki Control (Wis)",
        "Technology (Int)"
      ],
      "conditions": {
        "Empowered": "Advantage on Str checks/saves; +1d4 damage on Melee attacks, Melee Techniques, and Melee Weapon Techniques; count as 1 size larger for carrying/push/drag/lift.",
        "Super-Charged": "Advantage on Spirit checks and Clashes; +1d4 damage on Basic Ki Attacks and Ki Techniques.",
        "Bulk": "+1 Strength and -1 Dexterity per stage.",
        "Full Bodied Spirit": "Double max Stamina and HP in Other-World, halved in Land of the Living. Death destroys soul (requires Super Dragon Balls).",
        "Exhaustion": "10-level cumulative effect: -1 to all d20 checks per level; death at -10.",
        "Enraged": "Cannot concentrate, can cast spells/techniques. Lasts until end of next turn: +2 Power, +10 ft speed, +1 AC, +5 Temp Stamina.",
        "Berserk": "Must attack nearest creature each round; disadvantage on Wis checks/saves; auto-fail Int checks/saves; immune to charmed/frightened; also Enraged.",
        "Heavy Weight": "Per rank: -1 Str, -1 Dex, -5 ft speed, -1 Power.",
        "Light Weight": "Per rank: +1 Str, +1 Dex, +5 ft speed, +1 Power."
      }
    },
